{
  "nombre": "Cloudflare email+password",
  "servicio": "cloudflare",
  "session_key": "cloudflare_jaime",
  "email": "jaimepvicente@gmail.com",
  "steps": [
    {"action": "goto", "url": "https://dash.cloudflare.com/login", "wait_until": "domcontentloaded", "timeout": 60000},
    {"action": "sleep", "seconds": 10},
    {"action": "wait_for", "selector": "input[type=email], input[name=email], input[name=identifier]", "timeout": 30000},
    {"action": "fill", "selector": "input[type=email], input[name=email], input[name=identifier]", "value": "jaimepvicente@gmail.com"},
    {"action": "sleep", "seconds": 2},
    {"action": "press", "selector": "input[type=email], input[name=email], input[name=identifier]", "key": "Enter"},
    {"action": "sleep", "seconds": 6},
    {"action": "wait_for", "selector": "input[type=password], input[name=password]", "timeout": 30000},
    {"action": "fill", "selector": "input[type=password], input[name=password]", "value": "la gravedad curva la informacion"},
    {"action": "sleep", "seconds": 2},
    {"action": "press", "selector": "input[type=password], input[name=password]", "key": "Enter"},
    {"action": "sleep", "seconds": 10},
    {"action": "url"},
    {"action": "screenshot", "path": "/tmp/cf_after_login.png"}
  ]
}
