{
  "nombre": "Google bootstrap (login con password)",
  "servicio": "google",
  "session_key": "google_bootstrap",
  "email": "jaimepvicente@gmail.com",
  "steps": [
    {"action": "goto", "url": "https://accounts.google.com/signin/v2/identifier", "wait_until": "domcontentloaded", "timeout": 45000},
    {"action": "wait_for", "selector": "input[type=email]", "timeout": 20000},
    {"action": "fill", "selector": "input[type=email]", "value": "jaimepvicente@gmail.com"},
    {"action": "press", "selector": "input[type=email]", "key": "Enter"},
    {"action": "sleep", "seconds": 3},
    {"action": "wait_for", "selector": "input[type=password]", "timeout": 20000},
    {"action": "fill", "selector": "input[type=password]", "value": "la gravedad curva la informacion"},
    {"action": "press", "selector": "input[type=password]", "key": "Enter"},
    {"action": "sleep", "seconds": 8},
    {"action": "wait_email_code", "servicio_filter": "google", "timeout": 30, "optional": true},
    {"action": "url"},
    {"action": "save_session"}
  ]
}
