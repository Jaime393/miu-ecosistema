{
  "nombre": "CF dashboard con cookies",
  "servicio": "cloudflare",
  "session_key": "cloudflare_dashboard",
  "preload_storage": "cf",
  "steps": [
    {"action": "goto", "url": "https://dash.cloudflare.com/profile/api-tokens", "wait_until": "domcontentloaded", "timeout": 45000},
